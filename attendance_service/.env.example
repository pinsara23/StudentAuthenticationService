# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
# Local:  postgresql://<user>:<password>@localhost:5432/attendance_db
# Docker: postgresql://<user>:<password>@attendance-db:5432/attendance_db
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/attendance_db

# Auth Service token verification endpoint
# Docker: http://auth-service:8000/auth/verify-token
AUTH_SERVICE_URL=http://localhost:8000/auth/verify-token

# Student Service students endpoint
# Docker: http://student-service:8000/students
STUDENT_SERVICE_URL=http://localhost:8002/students
