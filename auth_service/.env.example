# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection string
# Local:  postgresql://<user>:<password>@localhost:5432/auth_db
# Docker: postgresql://<user>:<password>@auth-db:5432/auth_db
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/auth_db

# JWT settings — generate a strong key, e.g.: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
